# delta (git diff/show/log renklendirici) ayarlari. Bu dosya yalniz delta KURULUYSA ~/.gitconfig.delta olarak
# kopyalanir ve ~/.gitconfig'ten include edilir (tools/install-tools.sh); delta yokken git etkilenmez.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
